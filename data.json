  "scene": "let p=[],t=0;for(let i=0;i<40;i++)p.push({x:Math.random(),y:Math.random(),r:Math.random()*2+1,s:Math.random()*0.001+0.0005,a:Math.random()*Math.PI*2,c:PALETTE[i%3]});function draw(){let w=W(),h=H(),cx=w/2,cy=h/2;ctx.clearRect(0,0,w,h);t+=0.005;for(let i=0;i<6;i++){let ang=i*Math.PI/3+t*0.2,r=Math.min(w,h)*0.28;let x=cx+Math.cos(ang)*r,y=cy+Math.sin(ang)*r*0.7;ctx.save();ctx.translate(x,y);ctx.rotate(ang+t*0.1);ctx.beginPath();ctx.fillStyle=PALETTE[i%3];ctx.globalAlpha=0.12;ctx.ellipse(0,0,35,18,0,0,Math.PI*2);ctx.fill();ctx.strokeStyle=PALETTE[(i+1)%3];ctx.globalAlpha=0.3;ctx.lineWidth=1;ctx.stroke();ctx.restore();}p.forEach(pt=>{pt.y-=pt.s;pt.a+=0.02;if(pt.y<0)pt.y=1;let px=pt.x*w+Math.sin(pt.a)*15,py=pt.y*h;ctx.beginPath();ctx.arc(px,py,pt.r,0,Math.PI*2);ctx.fillStyle=pt.c;ctx.globalAlpha=0.4+Math.sin(pt.a)*0.2;ctx.fill();});requestAnimationFrame(draw);}draw();",
