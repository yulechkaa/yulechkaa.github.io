  "scene": "const N=30,pts=Array.from({length:N},()=>({x:Math.random(),y:Math.random(),r:1+Math.random()*2,s:0.0003+Math.random()*0.0006,a:Math.random()*Math.PI*2}));function render(t){ctx.clearRect(0,0,W(),H());const w=W(),h=H();[0.15,0.85].forEach((bx,side)=>{const dir=side===0?1:-1,baseRootX=bx*w,sway=Math.sin(t*0.001+side)*25,cp1x=baseRootX+dir*40+sway*0.5,cp1y=h*0.7,cp2x=baseRootX+dir*80+sway,cp2y=h*0.4,endX=baseRootX+dir*110+sway*1.2,endY=h*0.25;ctx.beginPath();ctx.strokeStyle=PALETTE[1]+'44';ctx.lineWidth=1.5;ctx.moveTo(baseRootX,h+20);ctx.bezierCurveTo(cp1x,cp1y,cp2x,cp2y,endX,endY);ctx.stroke();for(let i=1;i<=6;i++){const u=i/7,x=(1-u)**3*baseRootX+3*(1-u)**2*u*cp1x+3*(1-u)*u**2*cp2x+u**3*endX,y=(1-u)**3*(h+20)+3*(1-u)**2*u*cp1y+3*(1-u)*u**2*cp2y+u**3*endY,bellSway=Math.sin(t*0.002+i+side)*4,bellX=x+dir*14+bellSway,bellY=y+8;ctx.beginPath();ctx.strokeStyle=PALETTE[1]+'66';ctx.moveTo(x,y);ctx.quadraticCurveTo(x+dir*8,y+2,bellX,bellY);ctx.stroke();ctx.fillStyle=PALETTE[2]+'aa';ctx.beginPath();ctx.arc(bellX,bellY+4,4.5+i*0.6,Math.PI,0);ctx.lineTo(bellX+5,bellY+10);ctx.lineTo(bellX-5,bellY+10);ctx.closePath();ctx.fill();}});pts.forEach(p=>{p.y-=p.s*h*0.2;p.a+=0.02;if(p.y<0)p.y=1;const px=p.x*w+Math.sin(p.a)*15,py=p.y*h;ctx.beginPath();ctx.fillStyle=PALETTE[2]+'66';ctx.arc(px,py,p.r,0,Math.PI*2);ctx.fill();});requestAnimationFrame(render);}requestAnimationFrame(render);",
