  "scene": "let L=Array.from({length:40},()=>({x:Math.random()*W(),y:Math.random()*H(),vx:(Math.random()-0.5)*0.2,vy:(Math.random()-0.5)*0.2,r:Math.random()*4,c:PALETTE[Math.floor(Math.random()*3)]}));function R(){ctx.clearRect(0,0,W(),H());L.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>W())p.vx*=-1;if(p.y<0||p.y>H())p.vy*=-1;ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,6.28);ctx.fillStyle=p.c;ctx.globalAlpha=0.15;ctx.fill();ctx.beginPath();L.forEach(p2=>{let d=Math.hypot(p.x-p2.x,p.y-p2.y);if(d<120){ctx.moveTo(p.x,p.y);ctx.lineTo(p2.x,p2.y)}});ctx.strokeStyle=p.c;ctx.lineWidth=0.4;ctx.globalAlpha=0.08;ctx.stroke()});requestAnimationFrame(R)}R();",
